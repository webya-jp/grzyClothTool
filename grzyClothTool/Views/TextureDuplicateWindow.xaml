<Window x:Class="grzyClothTool.Views.TextureDuplicateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:grzyClothTool.Controls"
        xmlns:loc="clr-namespace:grzyClothTool.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc TexDup_Title}"
        Height="720"
        Width="1040"
        MinHeight="600"
        MinWidth="880"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush50}"
        Foreground="{DynamicResource Brush900}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Options -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush75}"
                BorderBrush="{DynamicResource Brush250}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8">
            <StackPanel>
                <WrapPanel>
                    <c:ModernLabelComboBox Width="330"
                                           Label="{loc:Loc TexDup_Scope}"
                                           ItemsSource="{Binding ScopeOptions}"
                                           SelectedItem="{Binding SelectedScope, Mode=TwoWay}" />
                    <c:ModernLabelCheckBox Width="360"
                                           Label="{loc:Loc TexDup_CompareImageContent}"
                                           IsChecked="{Binding CompareImageContent, Mode=TwoWay}" />
                </WrapPanel>
                <TextBlock Text="{loc:Loc TexDup_CompareImageContentHint}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="7,2,0,0"
                           Foreground="{DynamicResource Brush700}" />
            </StackPanel>
        </Border>

        <!-- Scan row -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <c:CustomButton Grid.Column="0"
                            x:Name="ScanButton"
                            AutomationProperties.AutomationId="TEXDUP SCAN"
                            Label="{loc:Loc TexDup_Scan}"
                            Width="160"
                            Height="38"
                            CornerRadius="5"
                            MyBtnClickEvent="Scan_Click" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock x:Name="StatusLabel"
                           AutomationProperties.AutomationId="TEXDUP STATUS"
                           Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush800}" />
                <ProgressBar Height="6"
                             Margin="0,4,0,0"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressValue}"
                             Visibility="{Binding ProgressVisibility}" />
            </StackPanel>
        </Grid>

        <!-- Summary -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Background="{DynamicResource Brush100}"
                BorderBrush="{DynamicResource Brush250}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8">
            <StackPanel>
                <TextBlock x:Name="SummaryLabel"
                           AutomationProperties.AutomationId="TEXDUP SUMMARY"
                           Text="{Binding SummaryText}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush950}" />
                <TextBlock Text="{loc:Loc TexDup_ShareNote}"
                           FontSize="11"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush700}" />
                <TextBlock Text="{Binding ExternalWarning}"
                           FontSize="11"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding ExternalWarningVisibility}"
                           Foreground="#d97706" />
            </StackPanel>
        </Border>

        <!-- Groups -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <c:CustomButton Label="{loc:Loc TexDup_SelectAll}" Width="130" Height="30" CornerRadius="5" Margin="0,0,6,0" MyBtnClickEvent="SelectAll_Click" />
                <c:CustomButton Label="{loc:Loc TexDup_SelectNone}" Width="130" Height="30" CornerRadius="5" MyBtnClickEvent="SelectNone_Click" />
            </StackPanel>

            <ListView Grid.Row="1"
                      x:Name="GroupList"
                      AutomationProperties.AutomationId="TEXDUP GROUP LIST"
                      ItemsSource="{Binding Groups}"
                      Background="{DynamicResource Brush50}"
                      Foreground="{DynamicResource Brush950}"
                      BorderBrush="{DynamicResource Brush250}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="ToolTip" Value="{Binding VariationsText}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSameDrawableDuplicates}" Value="True">
                                <Setter Property="Background" Value="#33f59e0b" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="90" Header="{loc:Loc TexDup_ColCount}" DisplayMemberBinding="{Binding CountText}" />
                        <GridViewColumn Width="110" Header="{loc:Loc TexDup_ColSize}" DisplayMemberBinding="{Binding SizeText}" />
                        <GridViewColumn Width="120" Header="{loc:Loc TexDup_ColSavable}" DisplayMemberBinding="{Binding SavableText}" />
                        <GridViewColumn Width="280" Header="{loc:Loc TexDup_ColDrawables}" DisplayMemberBinding="{Binding UsedByText}" />
                        <GridViewColumn Width="330" Header="{loc:Loc TexDup_ColVariations}" DisplayMemberBinding="{Binding VariationsText}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- Actions -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <c:CustomButton x:Name="RemoveVariationsButton"
                                AutomationProperties.AutomationId="TEXDUP REMOVE VARIATIONS"
                                Label="{loc:Loc TexDup_RemoveVariations}"
                                Width="260"
                                Height="40"
                                CornerRadius="5"
                                MyBtnClickEvent="RemoveVariations_Click" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <c:CustomButton Label="{loc:Loc Common_Close}"
                                Width="120"
                                Height="40"
                                CornerRadius="5"
                                Margin="0,0,8,0"
                                MyBtnClickEvent="Close_Click" />
                <c:CustomButton x:Name="ShareButton"
                                AutomationProperties.AutomationId="TEXDUP SHARE"
                                Label="{loc:Loc TexDup_ShareFiles}"
                                Width="220"
                                Height="40"
                                CornerRadius="5"
                                MyBtnClickEvent="Share_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
